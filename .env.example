# Copie este arquivo para ".env.local" e preencha com os valores reais.
# NUNCA suba o arquivo ".env.local" para o git — ele contém segredos.

# ── Banco de dados ────────────────────────────────────────────────
# URL com Transaction Pooler do Supabase (porta 6543) com ?pgbouncer=true
DATABASE_URL="postgres://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL de Conexão Direta ao banco (porta 5432) usada para as migrações
DIRECT_URL="postgres://postgres:[PASS]@db.[REF].supabase.co:5432/postgres"

# ── Autenticação (NextAuth) ───────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte"

# ── WhatsApp / Evolution API ──────────────────────────────────────
# CRON_SECRET: injetado automaticamente pela Vercel Cron em prod.
# Em dev, defina manualmente para testar o worker via curl.
CRON_SECRET="troque-por-um-segredo-forte"

# WORKER_SECRET: usado para chamadas manuais ao worker (ex: Railway cron, curl local).
WORKER_SECRET="troque-por-um-segredo-forte"

# Secret do webhook recebido da Evolution API.
# Configure na Evolution API para enviar: Authorization: Bearer <valor>
# Se não definido, qualquer request é aceito (útil em desenvolvimento).
WHATSAPP_WEBHOOK_SECRET="troque-por-um-segredo-forte"

# ── Worker autônomo (Railway / VPS) ──────────────────────────────
# Necessário apenas ao rodar scripts/worker.mjs (fora do Vercel Cron).
# APP_URL = URL pública do app Next.js no Railway
APP_URL="https://meuapp.railway.app"

# Intervalo do worker em ms (padrão: 60000 = 1 minuto)
# WORKER_INTERVAL_MS=60000

# URL pública do webhook que você cadastra na Evolution API:
# https://SEU-DOMINIO.com/api/eventos

# ── Asaas (cobrança de assinaturas) ──────────────────────────────
# Gere em: app.asaas.com → Integrações → API
ASAAS_API_KEY="$aact_..."
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/api/v3
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
# Webhook a cadastrar no Asaas: https://SEU-DOMINIO.com/api/webhooks/asaas

# ── Logging ──────────────────────────────────────────────────────
# Nível mínimo de log: debug | info | warn | error (padrão: info)
LOG_LEVEL="warn"

# ── Redis (Opcional - para Rate Limiting) ────────────────────────
# Necessário em produção na Vercel (múltiplas instâncias).
# Exemplo Upstash: redis://default:sua_senha@seu_endpoint.upstash.io:30559
REDIS_URL=""
