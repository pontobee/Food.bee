// =============================================================================
// schema.prisma — LancheSmart SaaS
// Stack: Railway PostgreSQL + Prisma ORM + Next.js 15 App Router
// Padrões: Multitenancy via id_lanchonete | Soft Deletes via inativo_em
//          RBAC (ADMIN/CAIXA) | LISTEN/NOTIFY via SSE | Webhook Queue
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"] // JOIN-level fetching nativo (Prisma 5.10+)
}

datasource db {
  provider  = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum PlanoAssinatura {
  TRIAL
  BASICO
  PRO
  ENTERPRISE
}

enum StatusAssinatura {
  ATIVA
  TRIAL
  INADIMPLENTE
  CANCELADA
  SUSPENSA
}

enum GatewayPagamento {
  ASAAS
  MERCADO_PAGO
}

enum RoleUsuario {
  ADMIN  // Acesso total — faturamento, margens, configurações
  CAIXA  // Acesso operacional — pedidos e caixa apenas
}

enum StatusPedido {
  AGUARDANDO  // Novo pedido recebido
  EM_PREPARO  // Cozinha notificada
  PRONTO      // Aguardando retirada/entrega
  ENTREGUE    // Finalizado com sucesso
  CANCELADO   // Cancelado com motivo
}

enum FormaPagamento {
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  PIX
}

enum OrigemPedido {
  BALCAO
  WHATSAPP
  TELEFONE
  CARDAPIO_DIGITAL
}

enum TipoEntrega {
  BALCAO
  DELIVERY
}

enum TipoAdicional {
  ADICIONAL  // Inclui item (+Bacon, +Queijo)
  EXCECAO    // Remove item (-Alface, -Cebola)
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

// Tipo de movimentação de estoque.
// O sinal (some ou subtrai) NÃO é guardado no número: ele vem do tipo.
// Assim a coluna `quantidade` é sempre positiva e fica impossível gravar
// uma entrada negativa por engano.
enum TipoMovimentacaoEstoque {
  ENTRADA  // reposição: compra de insumos, ajuste para mais
  SAIDA    // baixa: desperdício, perda, consumo interno, ajuste para menos
}

enum StatusWebhook {
  PENDENTE
  PROCESSANDO
  PROCESSADO
  ERRO
  IGNORADO // duplicata detectada pelo ID único do provider
}

enum TipoMensagemWhatsApp {
  CONFIRMACAO_PEDIDO
  PEDIDO_AGUARDANDO
  PEDIDO_EM_PREPARO
  PEDIDO_PRONTO
  PEDIDO_ENTREGUE
  PEDIDO_CANCELADO
  COBRANCA
  PROMO
  CUSTOM
}

enum StatusMensagemWhatsApp {
  ENVIADO
  ENTREGUE
  LIDO
  FALHOU
}

// =============================================================================
// LANCHONETE — raiz do tenant
// Cada registro representa um cliente do SaaS (uma lanchonete).
// =============================================================================

model Lanchonete {
  id         String    @id @default(uuid()) @db.Uuid
  nome       String    @db.VarChar(120)
  slug       String    @unique @db.VarChar(60) // rota e subdomínio ex: "hamburgueria-do-ze"
  telefone   String?   @db.VarChar(20)
  cnpj       String?   @unique @db.VarChar(18)
  endereco   String?
  logo_url   String?
  horarios   Json?     // { "0": { aberto, abertura, fechamento }, … } 0=Dom…6=Sáb
  criado_em  DateTime  @default(now()) @db.Timestamptz(3)
  inativo_em DateTime? @db.Timestamptz(3) // soft delete

  // relações
  assinatura       Assinatura?
  pix_config       PixConfig?
  whatsapp_config  WhatsAppConfig?
  sessoes_whatsapp SessaoWhatsApp[]
  taxas_entrega    TaxaEntrega[]
  usuarios         Usuario[]
  clientes         Cliente[]
  categorias       Categoria[]
  produtos         Produto[]
  produtos_adicionais ProdutoAdicional[]
  pedidos          Pedido[]
  transacoes       Transacao[]
  mensagens_whatsapp MensagemWhatsApp[]
  webhook_eventos  WebhookEvento[]
  movimentacoes_estoque MovimentacaoEstoque[]

  @@map("lanchonetes")
}

// =============================================================================
// ASSINATURA — monetização SaaS
// Um-para-um com Lanchonete. Gateway externo (Asaas / Mercado Pago).
// Middleware verifica status antes de renderizar qualquer rota do painel.
// =============================================================================

model Assinatura {
  id                      String           @id @default(uuid()) @db.Uuid
  lanchonete_id           String           @unique @db.Uuid
  plano                   PlanoAssinatura  @default(TRIAL)
  status                  StatusAssinatura @default(TRIAL)
  gateway                 GatewayPagamento?
  gateway_customer_id     String?          // ID do cliente no gateway
  gateway_subscription_id String?          @unique // ID da assinatura no gateway
  valor_mensal            Decimal          @default(0) @db.Decimal(10, 2)
  data_inicio             DateTime         @db.Timestamptz(3)
  data_vencimento         DateTime?        @db.Timestamptz(3)
  data_cancelamento       DateTime?        @db.Timestamptz(3)
  criado_em               DateTime         @default(now()) @db.Timestamptz(3)
  atualizado_em           DateTime         @updatedAt @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])

  @@map("assinaturas")
}

// =============================================================================
// USUARIO — autenticação + RBAC
// Gerenciado via NextAuth.js (Auth.js). senha_hash só quando Credentials provider.
// CAIXA: vê pedidos, produtos, clientes. NÃO vê faturamento nem margens.
// =============================================================================

model Usuario {
  id              String      @id @default(uuid()) @db.Uuid
  lanchonete_id   String      @db.Uuid
  nome            String      @db.VarChar(100)
  email           String      @db.VarChar(255)
  senha_hash      String?     // null quando OAuth provider
  role            RoleUsuario @default(CAIXA)
  ultimo_acesso_em DateTime?  @db.Timestamptz(3)
  criado_em       DateTime    @default(now()) @db.Timestamptz(3)
  inativo_em      DateTime?   @db.Timestamptz(3) // soft delete

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])
  pedidos    Pedido[]   // pedidos abertos por este usuário
  transacoes Transacao[]
  movimentacoes_estoque MovimentacaoEstoque[] // movimentações que este usuário registrou

  // email único por tenant (mesmo e-mail pode existir em lanchonetes diferentes)
  @@unique([lanchonete_id, email])
  @@index([lanchonete_id])
  @@map("usuarios")
}

// =============================================================================
// CLIENTE — base de clientes da lanchonete
// telefone único por tenant para deduplicação via WhatsApp.
// Campos agregados (total_pedidos, total_gasto) atualizados por trigger.
// =============================================================================

model Cliente {
  id              String    @id @default(uuid()) @db.Uuid
  lanchonete_id   String    @db.Uuid
  nome            String    @db.VarChar(120)
  telefone        String    @db.VarChar(20)
  endereco        String?
  total_pedidos   Int       @default(0)
  total_gasto     Decimal   @default(0) @db.Decimal(12, 2)
  criado_em       DateTime  @default(now()) @db.Timestamptz(3)
  inativo_em      DateTime? @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])
  pedidos    Pedido[]
  mensagens  MensagemWhatsApp[]

  @@unique([lanchonete_id, telefone])
  @@index([lanchonete_id])
  @@map("clientes")
}

// =============================================================================
// CATEGORIA — agrupamento de produtos no cardápio
// Ordem exibida no painel e app controlada pelo campo `ordem`.
// =============================================================================

model Categoria {
  id            String    @id @default(uuid()) @db.Uuid
  lanchonete_id String    @db.Uuid
  nome          String    @db.VarChar(80)
  descricao     String?
  ordem         Int       @default(0) // menor = aparece primeiro
  criado_em     DateTime  @default(now()) @db.Timestamptz(3)
  inativo_em    DateTime? @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])
  produtos   Produto[]

  @@index([lanchonete_id, ordem])
  @@map("categorias")
}

// =============================================================================
// PRODUTO — itens do cardápio
// preco_custo visível apenas para ADMIN (margem = venda - custo).
// estoque_atual decrementado automaticamente por trigger ao ENTREGAR pedido.
// =============================================================================

model Produto {
  id              String    @id @default(uuid()) @db.Uuid
  lanchonete_id   String    @db.Uuid
  categoria_id    String?   @db.Uuid
  nome            String    @db.VarChar(120)
  descricao       String?
  preco_venda     Decimal   @db.Decimal(10, 2)
  preco_custo     Decimal   @default(0) @db.Decimal(10, 2) // somente ADMIN visualiza
  estoque_atual      Int     @default(0)
  estoque_minimo     Int     @default(0) // alerta de estoque baixo
  controlar_estoque  Boolean @default(false)
  unidade         String    @default("un") @db.VarChar(10)
  imagem_url      String?
  criado_em       DateTime  @default(now()) @db.Timestamptz(3)
  inativo_em      DateTime? @db.Timestamptz(3)

  lanchonete   Lanchonete        @relation(fields: [lanchonete_id], references: [id])
  categoria    Categoria?        @relation(fields: [categoria_id], references: [id])
  adicionais   ProdutoAdicional[] // adicionais específicos deste produto
  itens_pedido ItemPedido[]
  movimentacoes MovimentacaoEstoque[] // histórico de entradas/saídas deste produto

  @@index([lanchonete_id])
  @@index([lanchonete_id, categoria_id])
  @@map("produtos")
}

// =============================================================================
// PRODUTO_ADICIONAL — modificadores do cardápio
// produto_id null = adicional global (disponível para qualquer produto).
// tipo ADICIONAL: cobra preco_extra. tipo EXCECAO: sem cobrança (remoção).
// =============================================================================

model ProdutoAdicional {
  id            String        @id @default(uuid()) @db.Uuid
  lanchonete_id String        @db.Uuid
  produto_id    String?       @db.Uuid // null = global
  nome          String        @db.VarChar(80) // "Bacon Extra", "Sem Alface"
  tipo          TipoAdicional @default(ADICIONAL)
  preco_extra   Decimal       @default(0) @db.Decimal(8, 2)
  criado_em     DateTime      @default(now()) @db.Timestamptz(3)
  inativo_em    DateTime?     @db.Timestamptz(3)

  lanchonete          Lanchonete           @relation(fields: [lanchonete_id], references: [id])
  produto             Produto?             @relation(fields: [produto_id], references: [id])
  itens_pedido_adicionais ItemPedidoAdicional[]

  @@index([lanchonete_id])
  @@index([lanchonete_id, produto_id])
  @@map("produtos_adicionais")
}

// =============================================================================
// PEDIDO — core da operação
// numero_pedido sequencial por tenant — gerado via sequence PostgreSQL por tenant.
// Timer do Kanban calculado via (now() - criado_em) no frontend.
// =============================================================================

model Pedido {
  id              String         @id @default(uuid()) @db.Uuid
  lanchonete_id   String         @db.Uuid
  cliente_id      String?        @db.Uuid
  usuario_id      String         @db.Uuid // quem abriu o pedido
  numero_pedido   Int            // sequencial por lanchonete (não UUID para exibição)
  status          StatusPedido   @default(AGUARDANDO)
  forma_pagamento FormaPagamento @default(DINHEIRO)
  origem          OrigemPedido   @default(BALCAO)
  subtotal        Decimal        @db.Decimal(10, 2)
  desconto        Decimal        @default(0) @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  troco           Decimal?       @db.Decimal(10, 2) // apenas para DINHEIRO
  observacao      String?
  motivo_cancelamento String?
  pago_em          DateTime?      @db.Timestamptz(3)
  pix_txid         String?        @db.VarChar(255)
  pix_qrcode       String?        @db.Text
  tipo_entrega     TipoEntrega    @default(BALCAO)
  taxa_entrega_id  String?        @db.Uuid
  taxa_entrega     Decimal?       @db.Decimal(8, 2) // snapshot do valor no momento do pedido
  endereco_entrega String?        @db.VarChar(255)
  criado_em        DateTime       @default(now()) @db.Timestamptz(3)
  atualizado_em   DateTime       @updatedAt @db.Timestamptz(3)
  inativo_em      DateTime?      @db.Timestamptz(3)

  lanchonete   Lanchonete    @relation(fields: [lanchonete_id], references: [id])
  cliente      Cliente?      @relation(fields: [cliente_id], references: [id])
  usuario      Usuario       @relation(fields: [usuario_id], references: [id])
  zona_entrega TaxaEntrega?  @relation(fields: [taxa_entrega_id], references: [id])
  itens        ItemPedido[]
  transacao    Transacao?

  // numero_pedido único por tenant
  @@unique([lanchonete_id, numero_pedido])
  // índices críticos para o Kanban (busca por status ativo) e relatórios
  @@index([lanchonete_id, status])
  @@index([lanchonete_id, criado_em(sort: Desc)])
  @@index([lanchonete_id, cliente_id])
  @@map("pedidos")
}

// =============================================================================
// ITEM_PEDIDO — linha do pedido
// Armazena snapshot de nome e preço — produto pode ser alterado/excluído depois.
// =============================================================================

model ItemPedido {
  id                    String  @id @default(uuid()) @db.Uuid
  lanchonete_id         String  @db.Uuid
  pedido_id             String  @db.Uuid
  produto_id            String? @db.Uuid // null se produto foi inativado
  produto_nome          String  @db.VarChar(120) // snapshot imutável
  produto_preco_unitario Decimal @db.Decimal(10, 2) // snapshot imutável
  quantidade            Int     @default(1)
  total                 Decimal @db.Decimal(10, 2)

  pedido     Pedido               @relation(fields: [pedido_id], references: [id])
  produto    Produto?             @relation(fields: [produto_id], references: [id])
  adicionais ItemPedidoAdicional[]

  @@index([lanchonete_id, pedido_id])
  @@map("itens_pedido")
}

// =============================================================================
// ITEM_PEDIDO_ADICIONAL — modificadores aplicados a um item
// Também armazena snapshot pois ProdutoAdicional pode ser editado.
// =============================================================================

model ItemPedidoAdicional {
  id                   String        @id @default(uuid()) @db.Uuid
  lanchonete_id        String        @db.Uuid
  item_pedido_id       String        @db.Uuid
  produto_adicional_id String?       @db.Uuid // null se adicional foi inativado
  nome                 String        @db.VarChar(80) // snapshot
  tipo                 TipoAdicional
  preco_extra          Decimal       @default(0) @db.Decimal(8, 2) // snapshot

  item_pedido       ItemPedido        @relation(fields: [item_pedido_id], references: [id])
  produto_adicional ProdutoAdicional? @relation(fields: [produto_adicional_id], references: [id])

  @@index([lanchonete_id, item_pedido_id])
  @@map("itens_pedido_adicionais")
}

// =============================================================================
// TRANSACAO — fluxo de caixa
// Receitas geradas automaticamente a partir de Pedido ENTREGUE.
// Despesas lançadas manualmente pelo ADMIN.
// CAIXA não visualiza este modelo — restringido por RBAC na API route.
// =============================================================================

model Transacao {
  id            String        @id @default(uuid()) @db.Uuid
  lanchonete_id String        @db.Uuid
  pedido_id     String?       @unique @db.Uuid // 1-para-1 com pedido quando receita
  usuario_id    String        @db.Uuid
  tipo          TipoTransacao
  categoria     String        @db.VarChar(60) // "Venda", "Insumo", "Aluguel" etc.
  descricao     String
  valor         Decimal       @db.Decimal(12, 2)
  data          DateTime      @default(now()) @db.Timestamptz(3)
  criado_em     DateTime      @default(now()) @db.Timestamptz(3)
  inativo_em    DateTime?     @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])
  pedido     Pedido?    @relation(fields: [pedido_id], references: [id])
  usuario    Usuario    @relation(fields: [usuario_id], references: [id])

  @@index([lanchonete_id, data(sort: Desc)])
  @@index([lanchonete_id, tipo])
  @@map("transacoes")
}

// =============================================================================
// MOVIMENTACAO_ESTOQUE — auditoria de entradas e saídas
// Cada linha é o registro imutável de UMA movimentação de estoque.
// Pense num extrato bancário: nunca editamos o saldo "no escuro", lançamos
// uma movimentação e ela explica como o saldo (Produto.estoque_atual) mudou.
//
// `estoque_antes` e `estoque_depois` são snapshots gravados no momento da
// operação — assim o histórico continua correto mesmo que o produto seja
// editado ou inativado depois. Quem grava aqui é o stock.service, sempre
// dentro de uma transação junto com o UPDATE de Produto.estoque_atual.
// =============================================================================

model MovimentacaoEstoque {
  id             String                  @id @default(uuid()) @db.Uuid
  lanchonete_id  String                  @db.Uuid
  produto_id     String                  @db.Uuid
  usuario_id     String                  @db.Uuid // quem registrou a movimentação
  tipo           TipoMovimentacaoEstoque
  quantidade     Int // sempre POSITIVO — o sinal vem de `tipo`
  estoque_antes  Int // saldo do produto antes desta movimentação (snapshot)
  estoque_depois Int // saldo do produto depois desta movimentação (snapshot)
  motivo         String? // "Compra de insumos", "Desperdício" etc.
  criado_em      DateTime                @default(now()) @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])
  produto    Produto    @relation(fields: [produto_id], references: [id])
  usuario    Usuario    @relation(fields: [usuario_id], references: [id])

  // extrato por produto e listagem cronológica (mais recente primeiro)
  @@index([lanchonete_id, produto_id])
  @@index([lanchonete_id, criado_em(sort: Desc)])
  @@map("movimentacoes_estoque")
}

// =============================================================================
// TAXA_ENTREGA — zonas/bairros com taxas de delivery por tenant
// =============================================================================

model TaxaEntrega {
  id            String    @id @default(uuid()) @db.Uuid
  lanchonete_id String    @db.Uuid
  nome          String    @db.VarChar(80)  // "Centro", "Bairro Norte", etc.
  taxa          Decimal   @db.Decimal(8, 2)
  tempo_min     Int?      // tempo estimado de entrega em minutos
  ativa         Boolean   @default(true)
  criado_em     DateTime  @default(now()) @db.Timestamptz(3)
  atualizado_em DateTime  @updatedAt @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])
  pedidos    Pedido[]

  @@index([lanchonete_id, ativa])
  @@map("taxas_entrega")
}

// =============================================================================
// PIX_CONFIG — credenciais do gateway Pix por tenant (Mercado Pago)
// access_token: APP_USR-... (produção) ou TEST-... (sandbox)
// =============================================================================

model PixConfig {
  id            String           @id @default(uuid()) @db.Uuid
  lanchonete_id String           @unique @db.Uuid
  gateway       GatewayPagamento @default(MERCADO_PAGO)
  access_token  String           @db.Text
  criado_em     DateTime         @default(now()) @db.Timestamptz(3)
  atualizado_em DateTime         @updatedAt @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])

  @@map("pix_configs")
}

// =============================================================================
// WHATSAPP_CONFIG — credenciais da Evolution API por tenant
// evolution_url: URL base do container (ex: https://evolution.meusite.com)
// evolution_api_key: chave global da instância Evolution
// instance_nome: nome da instância criada para esta lanchonete
// =============================================================================

model WhatsAppConfig {
  id              String   @id @default(uuid()) @db.Uuid
  lanchonete_id   String   @unique @db.Uuid
  evolution_url   String   @db.VarChar(255)
  evolution_api_key String @db.Text
  instance_nome   String   @db.VarChar(100)
  criado_em       DateTime @default(now()) @db.Timestamptz(3)
  atualizado_em   DateTime @updatedAt @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])

  @@map("whatsapp_configs")
}

// =============================================================================
// SESSAO_WHATSAPP — estado da conversa do bot por cliente
// estado: MENU | CARRINHO | TIPO_ENTREGA | ENDERECO | PAGAMENTO
// dados:  JSON com carrinho, tipo_entrega, endereco_entrega, menu_map
// Expira após inatividade — expirada é tratada como sessão nova.
// =============================================================================

model SessaoWhatsApp {
  id            String   @id @default(uuid()) @db.Uuid
  lanchonete_id String   @db.Uuid
  telefone      String   @db.VarChar(20)
  estado        String   @db.VarChar(30)
  dados         Json     @default("{}")
  expira_em     DateTime @db.Timestamptz(3)
  atualizado_em DateTime @updatedAt @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])

  @@unique([lanchonete_id, telefone])
  @@index([expira_em])
  @@map("sessoes_whatsapp")
}

// =============================================================================
// WEBHOOK_EVENTO — fila de webhooks do WhatsApp (Evolution API)
// id_externo: ID único fornecido pelo provider — constraint UNIQUE garante
// idempotência. O endpoint POST retorna 200 OK imediatamente e persiste o payload.
// Um worker background faz SELECT ... FOR UPDATE SKIP LOCKED e processa a fila.
// =============================================================================

model WebhookEvento {
  id              String        @id @default(uuid()) @db.Uuid
  id_externo      String        @unique @db.VarChar(255) // ID do provider — idempotência
  lanchonete_id   String?       @db.Uuid // null até ser resolvido pelo worker
  payload         Json          // raw body do webhook
  status          StatusWebhook @default(PENDENTE)
  tentativas      Int           @default(0)
  erro_mensagem   String?       // último erro para debug
  recebido_em     DateTime      @default(now()) @db.Timestamptz(3)
  processado_em   DateTime?     @db.Timestamptz(3)

  lanchonete Lanchonete? @relation(fields: [lanchonete_id], references: [id])

  // worker usa esse índice para buscar PENDENTE mais antigo primeiro
  @@index([status, recebido_em(sort: Asc)])
  @@index([lanchonete_id])
  @@map("webhook_eventos")
}

// =============================================================================
// _PEDIDO_SEQ — contador de numero_pedido sequencial por tenant
// Usado pela função SQL next_numero_pedido() (ver migration de funções/triggers).
// Tabela auxiliar, sem relação direta no client — evita gaps em rollback.
// =============================================================================

model PedidoSeq {
  lanchonete_id String @id @db.Uuid
  seq           BigInt @default(0)

  @@map("_pedido_seq")
}

// =============================================================================
// MENSAGEM_WHATSAPP — histórico de envios
// Registrada após tentativa de envio via Evolution API.
// Atualizada por webhook de status (delivered, read, failed).
// =============================================================================

model MensagemWhatsApp {
  id              String                 @id @default(uuid()) @db.Uuid
  lanchonete_id   String                 @db.Uuid
  cliente_id      String?                @db.Uuid
  pedido_id       String?                @db.Uuid
  numero_destino  String                 @db.VarChar(20)
  mensagem        String
  tipo            TipoMensagemWhatsApp
  status          StatusMensagemWhatsApp @default(ENVIADO)
  id_mensagem_wpp String?                @unique @db.VarChar(255) // ID retornado pela Evolution API
  enviado_em      DateTime               @default(now()) @db.Timestamptz(3)
  atualizado_em   DateTime               @updatedAt @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchonete_id], references: [id])
  cliente    Cliente?   @relation(fields: [cliente_id], references: [id])

  @@index([lanchonete_id, enviado_em(sort: Desc)])
  @@index([lanchonete_id, cliente_id])
  @@map("mensagens_whatsapp")
}
