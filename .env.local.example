# Copie este arquivo para ".env.local" e preencha com os dados do SEU projeto Supabase.
# Onde encontrar: painel do Supabase → Project Settings → API
#
# NUNCA suba o arquivo ".env.local" para o git — ele contém suas chaves.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public-aqui
AUTH_SECRET=""  # gere com: openssl rand -base64 32
EVOLUTION_WEBHOOK_SECRET=""  # segredo enviado pela Evolution API no header Authorization: Bearer <secret>
LOG_LEVEL="warn"             # nível mínimo de log: debug | info | warn | error (padrão: info)
